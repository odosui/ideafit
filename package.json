{
  "name": "ideafit",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-modal": "^3.13.1",
    "sass": "^1.32.12",
    "typescript": "^7.0.2"
  },
  "version": "0.1.0",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "vite": "^8.0.16",
    "vite-plugin-ruby": "^5.2.4"
  },
  "scripts": {
    "types": "tsc --project tsconfig.json --noEmit --preserveWatchOutput --watch",
    "ts": "tsc --project tsconfig.json --noEmit --watch",
    "typesonce": "tsc --project tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:embed": "vite build --config vite.embed.config.mts",
    "format": "prettier --write \"**/*.{ts,tsx,scss,sass}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,scss,sass}\"",
    "prepare": "husky",
    "lint": "oxlint"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{scss,sass}": "prettier --write"
  }
}
