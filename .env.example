# Public URL of this Ideafit instance. Used in sign-in emails and by the embed widget.
APP_URL=http://localhost:3000

# Signs sessions and sign-in links. Leave empty to generate one on first boot
# (kept in the storage volume). Generate your own with: openssl rand -hex 64
SECRET_KEY_BASE=

# Sender of all emails. Without it: the SMTP username if it's an email address,
# otherwise noreply@ the APP_URL host.
MAIL_FROM=Ideafit <ideafit@example.com>

# Outgoing email. Without SMTP_ADDRESS, emails are written to the app log instead,
# so you can copy the sign-in link from `docker logs ideafit`.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=

# Comma-separated emails that become admins when they sign in. Only admins create boards.
# Without it, the first person to sign in becomes the admin.
ADMIN_EMAILS=

# Sites allowed to embed boards in an iframe, comma-separated (e.g. acme.com, *.acme.com).
# Without it, any site can embed them.
EMBED_ALLOWED_DOMAINS=
