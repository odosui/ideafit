<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>Sign in · Ideafit</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/icons" %>

    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'auth.scss' %>

    <%= render "layouts/fonts" %>
  </head>
  <body>
    <div class="auth-brand">
      <img class="auth-brand__mark" src="/logo.png" alt="">
      Ideafit
    </div>
    <main class="auth-card card card--raised">
      <%= yield %>
    </main>
  </body>
</html>
