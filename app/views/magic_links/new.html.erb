<h1>Sign in</h1>
<p>We'll email you a link to sign in. No password needed.</p>
<% if flash[:alert] %>
  <div class="auth-alert" role="alert"><%= flash[:alert] %></div>
<% end %>
<%= form_with url: magic_links_path, class: "auth-form" do |f| %>
  <%= f.hidden_field :return_to, value: params[:return_to] %>
  <%= f.label :email, "Email" %>
  <%= f.email_field :email, value: params[:email], placeholder: "you@example.com", autofocus: true, autocomplete: "email", required: true %>
  <%= f.button "Email me a sign-in link", type: "submit" %>
<% end %>
