<% font = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
  </head>

  <body style="margin:0;padding:0;background-color:#f6f4ee;-webkit-text-size-adjust:100%;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f6f4ee;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
            <tr>
              <td style="padding:0 4px 16px;font-family:Georgia, 'Times New Roman', serif;font-size:20px;font-weight:700;color:#0a0a0a;">
                Ideafit
              </td>
            </tr>
            <tr>
              <td style="padding:32px;background-color:#ffffff;border:1px solid #e5e0d0;border-radius:12px;font-family:<%= font %>;font-size:15px;line-height:1.6;color:#1f2937;">
                <%= yield %>
              </td>
            </tr>
            <% if content_for?(:footer) %>
              <tr>
                <td style="padding:20px 4px 0;font-family:<%= font %>;font-size:12px;line-height:1.6;color:#6b7280;">
                  <%= yield :footer %>
                </td>
              </tr>
            <% end %>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
